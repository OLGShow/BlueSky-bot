# BlueSky Bot Configuration
# =========================

# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# Получите эти данные в настройках вашего BlueSky аккаунта
BLUESKY_HANDLE=your-bot.bsky.social
BLUESKY_PASSWORD=your-app-password

# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ (опционально)
# OpenAI используется только как резервный вариант, основной AI - Pollinations.AI
OPENAI_API_KEY=your-openai-key-optional

# СИСТЕМНЫЕ НАСТРОЙКИ
# Не изменяйте без необходимости
PYTHONPATH=/home/username/BlueSky-Bot
LOG_LEVEL=INFO
# ЛОГИ: лимиты для ротации/очистки (важно для маленького диска)
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=8
LOG_TOTAL_BUDGET_BYTES=1073741824

# НАСТРОЙКИ РЕЖИМА РАБОТЫ
# Включен режим соблюдения правил BlueSky (автоматические комментарии отключены)
BLUESKY_COMPLIANT_MODE=true
NO_AUTO_COMMENTS=true
NO_AUTO_MENTIONS=true

# ПРОИЗВОДИТЕЛЬНОСТЬ
# Более человеческие интервалы между постами (60-90 минут)
POST_INTERVAL_MIN=60
POST_INTERVAL_MAX=90
MAX_POSTS_PER_DAY=10
MAX_INTERACTIONS_PER_CYCLE=5

# DRY-RUN режим (никакие действия не отправляются в API)
# DRY_RUN=false